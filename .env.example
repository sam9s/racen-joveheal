# JoveHeal Environment Variables Template
# ========================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to Git!
#

# ===================
# Database (Required)
# ===================
POSTGRES_USER=joveheal
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE
POSTGRES_DB=joveheal

# For external database, use full connection string:
# DATABASE_URL=postgresql://user:password@host:5432/database

# ===================
# OpenAI (Required)
# ===================
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE

# ===================
# NextAuth (Required)
# ===================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=YOUR_RANDOM_SECRET_HERE

# Full URL of your deployed application
NEXTAUTH_URL=https://yourdomain.com

# ===================
# Google OAuth (Required)
# ===================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ===================
# Flask Backend (Required)
# ===================
# Generate with: openssl rand -base64 32
SESSION_SECRET=YOUR_FLASK_SESSION_SECRET
INTERNAL_API_KEY=YOUR_INTERNAL_API_KEY

# ===================
# Admin Panel (Optional)
# ===================
ADMIN_EMAILS=admin@example.com
DASHBOARD_EMAIL=admin@example.com
DASHBOARD_PASSWORD=YOUR_ADMIN_PASSWORD

# ===================
# Customization (Optional)
# ===================
RACEN_PERSONA_MODE=detailed

# ===================
# Domain (for SSL)
# ===================
DOMAIN=yourdomain.com
ADMIN_EMAIL=admin@example.com
