# ==============================================
# JoveHeal Wellness Chatbot - Git Ignore Config
# ==============================================
# IMPORTANT: The following folders ARE tracked (not ignored):
# - knowledge_base/ (documents, metadata)
# - docs/ (documentation)
# - transcripts/ (coaching session transcripts)
# - chroma_db/ (vector database)
# - backups/ (backup metadata)
# - disaster_recovery/ (recovery scripts)
# ==============================================

# Dependencies (regenerated by npm/pip install)
node_modules/
.pnpm-store/

# Next.js build output (regenerated by build)
.next/
out/

# Python cache (regenerated automatically)
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.venv/
venv/
ENV/

# Environment files (NEVER push secrets - use Replit Secrets instead)
.env
.env.local
.env.production
.env.development

# Vector DB cache (NOT the main chroma_db)
vector_db/

# Logs (regenerated at runtime)
logs/
*.log
npm-debug.log*

# Test outputs (temporary)
stress_test/

# Attached assets (user uploads, screenshots - large files)
attached_assets/

# Screenshot files (temporary)
response_*.png

# Android build outputs (regenerated by Gradle)
android/app/build/
android/.gradle/
android/build/
android/local.properties
android/.idea/
android/*.iml
android/app/*.iml

# iOS build outputs (if added later)
ios/App/build/
ios/App/Pods/
ios/.xcode.env.local

# Capacitor generated (regenerated by cap sync)
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# IDE settings
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Replit specific (platform-managed)
.cache/
.local/
.upm/
.replit
replit.nix

# Misc temp files
*.bak
*.tmp
