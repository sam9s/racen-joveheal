# Streamlit Admin Panel Dockerfile
# ================================
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY *.py ./
COPY .streamlit/ ./.streamlit/
COPY pages/ ./pages/ 2>/dev/null || true

# Create directories for data
RUN mkdir -p vector_db knowledge_base

# Expose Streamlit port
EXPOSE 5001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5001/_stcore/health || exit 1

# Start Streamlit
CMD ["streamlit", "run", "admin_dashboard.py", "--server.port=5001", "--server.address=0.0.0.0"]
